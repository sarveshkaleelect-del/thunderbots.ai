# This file lives at backend/.env.example
# Copy to backend/.env and fill in your values

APP_NAME=ThunderBots
DEBUG=true
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_32_CHAR_STRING_IN_PRODUCTION
APP_BASE_URL=http://localhost:3000
APP_API_URL=http://localhost:8000

DATABASE_URL=postgresql://thunderbots:password@localhost:5432/thunderbots
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=["http://localhost:3000"]

# Smart Shop Assistant — base URL of the deployed frontend, encoded into
# every shop's QR code (defaults to localhost for dev).
FRONTEND_BASE_URL=http://localhost:3000

# ── AI Provider (Google Gemini) ──────────────────────────────────────────────
# Add a key here for an environment-level fallback.
# Users can also add their own key through Settings → API Keys in the UI.

GEMINI_API_KEY=AIza...
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# ── Knowledge Base ───────────────────────────────────────────────────────────
# IMPORTANT: Inside Docker, CHROMA_PORT must be 8000 (the container port).
# The docker-compose.yml already overrides this. For local dev use 8001.
CHROMA_HOST=localhost
CHROMA_PORT=8001
# Embeddings automatically use your configured Gemini key (per-user
# Settings → API Keys, or GEMINI_API_KEY above) — no action needed for the
# common case. EMBEDDING_PROVIDER exists only to force the value explicitly
# server-wide; Gemini is the only supported value.
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_RETRIEVAL_RESULTS=5
RETRIEVAL_SCORE_THRESHOLD=0.3

# ── Upload ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/thunderbots_uploads
MAX_UPLOAD_SIZE_MB=50

# ── History ──────────────────────────────────────────────────────────────────
MAX_HISTORY_VERSIONS=50

# ── Email & Notifications ────────────────────────────────────────────────────
# EMAIL_PROVIDER: console (default, logs only — safe with no setup) | smtp | sendgrid
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=thunderbots.ai@gmail.com
EMAIL_FROM_NAME=ThunderBots
# EMAIL_REPLY_TO=thunderbots.ai@gmail.com

# SMTP (used when EMAIL_PROVIDER=smtp) — e.g. Amazon SES, Postmark, Mailgun
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-smtp-password
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# SendGrid HTTP API (used when EMAIL_PROVIDER=sendgrid)
# SENDGRID_API_KEY=SG....

PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ── Google SSO & Two-Factor Authentication ───────────────────────────────────
# Leave GOOGLE_CLIENT_ID unset to keep "Sign in with Google" disabled — the
# API returns 503 for it and the frontend simply hides the button.
# Create one at https://console.cloud.google.com/apis/credentials
# (OAuth client ID -> Web application) and add your frontend origin(s) under
# "Authorized JavaScript origins". No client secret is needed: the frontend
# uses Google Identity Services to obtain a signed ID token, which the
# backend verifies directly against Google's public keys.
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# Must match the value above — read by the Next.js frontend at build time.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# TOTP 2FA has no required configuration — it's per-user opt-in from
# Settings -> Security once logged in. MFA_TOKEN_EXPIRE_MINUTES controls how
# long a user has to enter their code after a correct password/Google
# sign-in before having to start over.
MFA_TOKEN_EXPIRE_MINUTES=5

# Active Sessions & Device Management has no required configuration either.
# IP_GEOLOCATION_ENABLED is OFF by default — the sessions list simply shows
# each device's IP address instead of a city/region/country. Turning it on
# makes a best-effort external lookup (ip-api.com, free, no key) at login
# time only, and always fails silently (never blocks login) if it times out
# or the service is unreachable.
# IP_GEOLOCATION_ENABLED=true
# IP_GEOLOCATION_TIMEOUT_SECONDS=2.0

# Audit Log has no required configuration either — every account/admin
# action is logged regardless. AUDIT_LOG_RETENTION_DAYS only controls how
# long rows are KEPT ELIGIBLE for deletion by
# services.audit_service.purge_expired(); nothing calls that function on a
# schedule automatically, so logs are kept forever unless you wire it into
# a cron/Celery beat job yourself. Set to 0 to make that intent explicit
# (disables pruning even if a job is later added).
# AUDIT_LOG_RETENTION_DAYS=365

# Comma-separated list of addresses to receive unhandled-server-error alerts.
# Leave empty to disable error notification emails entirely.
# ADMIN_NOTIFICATION_EMAILS=["thunderbots.ai@gmail.com"]

# ── AI CALL AGENT — REALTIME CALLS (NEW, Voice AI Part 3) ─────────────────
# Reuses TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM_NUMBER from the
# Phone Verification section above. Uncomment and set BACKEND_PUBLIC_URL to
# a publicly reachable URL (e.g. your ngrok/cloud URL) for Twilio to reach
# this backend's TwiML/Media Stream webhooks. Without it, inbound/outbound
# calls cannot be placed and the API returns 503 (feature stays fully inert).
# BACKEND_PUBLIC_URL=https://your-backend.example.com

# Realtime STT for inbound call audio. Without a key, calls still connect
# but play a "speech recognition not configured" message and end.
# DEEPGRAM_API_KEY=

# Defaults used when a phone number hasn't picked its own AI voice/speed/
# language yet (Settings on the /call-agent page). Same provider catalog
# as Voice Responses (Part 1) — voice keys are the ones already saved under
# Settings -> API Keys, nothing new to configure per-provider.
# VOICE_CALL_DEFAULT_VOICE_PROVIDER=gemini
# VOICE_CALL_DEFAULT_VOICE_ID=Kore
# VOICE_CALL_DEFAULT_SPEED=1.0
# VOICE_CALL_DEFAULT_LANGUAGE=en-US
