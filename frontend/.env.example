# Copy to frontend/.env.local and fill in your values

# Base URL the browser uses to reach the backend API (baked into the
# client bundle at `next build` time — see frontend/Dockerfile).
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL for live chat / voice streaming
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Public site URL (used for canonical links, sitemap, share URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match backend GOOGLE_CLIENT_ID. Leave unset to hide "Sign in with Google".
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
